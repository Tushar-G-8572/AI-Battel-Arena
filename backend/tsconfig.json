{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "public",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2022",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true
  },

  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}